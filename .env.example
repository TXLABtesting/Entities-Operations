# Frontend environment — copy to `.env` and fill in for your deployment.

# Auth: demo/frontend-only mode bypasses real OIDC and uses a demo user.
VITE_AUTH_ENABLED=false
VITE_DEMO_AUTH_ENABLED=true

# Optional umami analytics (leave empty to disable).
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# ── Readiness AI reviewer — INTERNAL AI gateway ─────────────────────────────
# These drive the AI evaluation in the "مراجعة جاهزية الأتمتة" review.
# Leave EMPTY for the demo: the app falls back to the deterministic rules engine.
# IT: point these at the internal AI gateway (OpenAI-compatible or Anthropic).
#
#   VITE_AI_API_URL     base URL of the gateway.
#                       openai format → POSTs to {URL}/chat/completions
#                       anthropic format → POSTs to {URL}/messages
#   VITE_AI_API_KEY     bearer token (sent as Authorization: Bearer ...).
#                       NOTE: VITE_* vars ship in the browser bundle; for
#                       production prefer a same-origin proxy route that holds
#                       the real secret server-side.
#   VITE_AI_MODEL       model id (e.g. gpt-4o, claude-opus-...).
#   VITE_AI_API_FORMAT  "openai" (default) or "anthropic".
VITE_AI_API_URL=
VITE_AI_API_KEY=
VITE_AI_MODEL=
VITE_AI_API_FORMAT=
